+
+func _set_vertical_focus_order(container: VBoxContainer) -> void :
+	var buttons = []
+	for child in container.get_children():
+		if child is Button and child.visible and child.focus_mode != Control.FOCUS_NONE:
+			buttons.push_back(child)
+	for i in range(buttons.size()):
+		var button = buttons[i]
+		button.focus_neighbour_left = ""
+		button.focus_neighbour_right = ""
+		button.focus_neighbour_top = buttons[i - 1].get_path() if i > 0 else ""
+		button.focus_neighbour_bottom = buttons[i + 1].get_path() if i + 1 < buttons.size() else ""
 
 
